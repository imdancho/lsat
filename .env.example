# Copy to .env.local for local development (git-ignored) and set the same
# names in Vercel → Project → Settings → Environment Variables.
# All of these are read on the server only. Never commit real values.

# Anthropic API key for AI grading and question generation.
ANTHROPIC_API_KEY=

# Stripe test-mode secret key (starts with sk_test_). Demo checkout only —
# never put a live key here.
STRIPE_SECRET_KEY=

# Stripe test-mode publishable key (starts with pk_test_). With it, the card
# form is shown on the pricing page itself; without it, checkout opens on
# Stripe's hosted page.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. The two plans default to the Stripe products "Prephrase Pro" and
# "Prephrase Until Test Day" (their ids are in lib/stripe.ts) and charge each
# product's default price. Set a product id (prod_…) or a price id (price_…)
# here to use something else.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEST_DAY=

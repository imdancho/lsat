# Copy to .env.local for local development (git-ignored) and set the same
# names in Vercel → Project → Settings → Environment Variables.
# All of these are read on the server only. Never commit real values.

# Anthropic API key for AI grading and question generation.
ANTHROPIC_API_KEY=

# Stripe test-mode secret key (starts with sk_test_). Demo checkout only —
# never put a live key here.
STRIPE_SECRET_KEY=

# Stripe price IDs: "Prephrase Pro" ($29/month, recurring) and
# "Prephrase Until Test Day" ($99, one-time).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEST_DAY=
